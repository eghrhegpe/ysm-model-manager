#!/bin/sh
# YMM commit-msg — 提交信息减负闸（ADR-338-d1 刀2：阻断集开闸）
#
# 职责：把 ADR-338-d1 D2 的判据跑在待提交的 message 上。判定与渲染全在
#   scripts/_lib/commit-blocks/commit-message.ts（纯函数，可单测），本壳只做接线。
#   此前仓内 42 个 check-*.ts + pre-commit 三段硬阻断，无一校验提交信息本身。
#
# 刀2（2026-10-25 开闸）：本文件唯一改动 = 加 --strict，规则一行不动。
#   但「--strict」不等于「所有 hard 规则都拒」——阻断集是显式白名单
#   `BLOCKING_RULES`（subject-empty / subject-prefix 两条），其余 hard 规则仍只提示。
#   依据：replay 300 实测 prefix 命中 4 条**全是真阳性**（无前缀的「更新文档」），
#   而 subject-length 占 35% 且多为单主题偏长——硬拒后者等于让闸「数长度」。
#   提示信息走 stderr 直达终端（AI 必看通道，同 pre-commit 口径）。
#
# 安装：git config core.hooksPath .githooks（仓库已配置）
# 逃生阀：YSM_SKIP_COMMIT_MSG=1 → 跳过判定，但复用 hook-audit.ts 写 SKIPPED_PRECOMMIT 留痕
#         （ADR-232 D2「逃生必须留痕」；`--no-verify` 整钩不跑无痕迹，故另有 --range 双挂）
exec 1>&2
set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || exit 0)"
[ -z "${ROOT:-}" ] && exit 0
MSG="${1:-}"
[ -z "$MSG" ] && exit 0

# node 定位（Windows 多 git/node 环境兼容，逐字同 pre-commit 段）
NODE="$(command -v node 2>/dev/null)"
if [ -z "${NODE:-}" ]; then
  SYS_NODE="/c/Program Files/nodejs"
  [ -d "$SYS_NODE" ] && PATH="$SYS_NODE:$PATH"
  export PATH
  NODE="$(command -v node 2>/dev/null)"
fi
if [ -z "${NODE:-}" ]; then
  echo "⚠️  [commit-msg] node 不可用（PATH 异常），跳过提交信息判定"
  exit 0
fi

if [ "${YSM_SKIP_COMMIT_MSG:-0}" = "1" ]; then
  echo "[commit-msg] YSM_SKIP_COMMIT_MSG=1，跳过提交信息判定（已留痕 SKIPPED_PRECOMMIT）"
  PARENT="$(git rev-parse HEAD 2>/dev/null || echo "")"
  "$NODE" "$ROOT/scripts/_lib/hook-audit.ts" write "${PARENT:-}" YSM_SKIP_COMMIT_MSG || true
  exit 0
fi

# 退出码分流（刀2）：
#   0 = 合规 → 放行
#   1 = 命中阻断集（subject-empty / subject-prefix）→ 拒提交，作者当场加前缀即可
#   2 = 判不了（message 文件读不到 / git 不可用）→ 降级为提示放行。
#       fail-closed 的兜底在**推送侧**：gate-config 的 --range auto 条目 exit 2 会让
#       pre-push-gate 记 FAIL（parseToolOutput 对 rc≠0 一律 not ok），远端零损失。
#       钩子这层若也硬拦，等于把「环境坏了」变成「谁都提交不了且改不动」。
rc=0
"$NODE" "$ROOT/scripts/check-commit-message.ts" --file "$MSG" --strict || rc=$?
if [ "$rc" = "1" ]; then
  echo "[commit-msg] ❌ 已阻断（YSM_SKIP_COMMIT_MSG=1 可跳过并留痕）"
  exit 1
fi
if [ "$rc" != "0" ]; then
  echo "[commit-msg] ⚠️  判定不可用（rc=$rc），本次放行；推送时 --range 双挂会复验"
fi
exit 0
