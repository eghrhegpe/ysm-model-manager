#!/bin/sh
# YMM pre-commit — 秒级文档/索引自动同步（非阻断）
# 职责：commit 前自动跑全部秒级 gen 脚本，同步文档/索引/知识卡机器生成区，并 stage 生成文件。
#       文档与源码同步在 commit 时自动完成，push 时 pre-push 全量门禁兜底。
# 安装：git config core.hooksPath .githooks（仓库已配置）
# 逃生阀：YSM_SKIP_GEN=1 git commit  或  git commit --no-verify
# 设计原则：
#   - 只做「快速更新 + stage」，不做阻断检查（阻断留给 pre-push）
#   - 任何 gen 失败仅提示，不阻断 commit
#   - 幂等：文档已同步时无 diff，git add docs/ 无副作用
#   - 输出全走 stderr（exec 1>&2）：Windows git hook 下 stdout 管道易断，且 stderr 是 AI 必看的终端通道
exec 1>&2
set -u
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || exit 0)"
[ -z "${ROOT:-}" ] && exit 0

# ── 逃生阀 ──
if [ "${YSM_SKIP_GEN:-0}" = "1" ]; then
  echo "[pre-commit] YSM_SKIP_GEN=1, 跳过文档同步"
  exit 0
fi

# ── 环境修正（Windows 多 git/node 环境兼容，同 pre-push） ──
command -v node >/dev/null 2>&1 || {
  SYS_NODE="/c/Program Files/nodejs"
  [ -d "$SYS_NODE" ] && PATH="$SYS_NODE:$PATH"
  export PATH
  command -v node >/dev/null 2>&1 || {
    echo "⚠️  node 不可用（PATH 异常）。跳过文档自动同步。"
    exit 0
  }
}

cd "$ROOT"

# ── 秒级文档同步（全部输出在 docs/ 下；失败不阻断） ──
# 注意：不放任何触发 vitest/coverage 的命令——覆盖率建议由 prepare-commit-msg
# 只读 frontend/coverage/coverage-final.json，不在此触发（避免提交前跑慢检查）。
echo "[pre-commit] 文档自动同步..."
GEN_CMDS='gen-docs-index.mjs
funcmap.mjs
gen-knowledge-index.mjs
gen-routes.mjs
build-novel-index.mjs
gen-project-map.mjs
gen-vitepress-sidebar.mjs
gen-knowledge-h1.mjs
gen-knowledge-symbols.mjs
gen-knowledge-adr.mjs
gen-knowledge-tests.mjs'
echo "$GEN_CMDS" | while IFS= read -r line; do
  [ -z "$line" ] && continue
  # shellcheck disable=SC2086（有意分词以携带 --file 等参数）
  node scripts/$line >/dev/null 2>&1 || echo "⚠️  scripts/$line 执行失败（不阻断）"
done

# ── stage 生成的文档（无 diff 则无副作用） ──
git add docs/ 2>/dev/null || true

echo "[pre-commit] ✅ 文档已同步并 stage"
exit 0
