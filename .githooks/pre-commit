#!/bin/sh
# YMM pre-commit — 秒级文档/索引自动同步（非阻断）
# 职责：commit 前自动跑全部秒级 gen 脚本，同步文档/索引/知识卡机器生成区，并 stage 生成文件。
#       文档与源码同步在 commit 时自动完成，push 时 pre-push 全量门禁兜底。
# 安装：git config core.hooksPath .githooks（仓库已配置）
# 逃生阀：YSM_SKIP_GEN=1 git commit  或  git commit --no-verify
# 设计原则：
#   - 只做「快速更新 + stage」，不做阻断检查（阻断留给 pre-push）
#   - 任何 gen 失败仅提示，不阻断 commit
#   - 幂等：文档已同步时无 diff，git add docs/ 无副作用
#   - 输出全走 stderr（exec 1>&2）：Windows git hook 下 stdout 管道易断，且 stderr 是 AI 必看的终端通道
exec 1>&2
set -u
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || exit 0)"
[ -z "${ROOT:-}" ] && exit 0

# ── 逃生阀 ──
if [ "${YSM_SKIP_GEN:-0}" = "1" ]; then
  echo "[pre-commit] YSM_SKIP_GEN=1, 跳过文档同步"
  exit 0
fi

# ── 环境修正（Windows 多 git/node 环境兼容，同 pre-push） ──
command -v node >/dev/null 2>&1 || {
  SYS_NODE="/c/Program Files/nodejs"
  [ -d "$SYS_NODE" ] && PATH="$SYS_NODE:$PATH"
  export PATH
  command -v node >/dev/null 2>&1 || {
    echo "⚠️  node 不可用（PATH 异常）。跳过文档自动同步。"
    exit 0
  }
}

cd "$ROOT"

# ── 秒级文档同步（全部输出在 docs/ 下；失败不阻断） ──
# 注意：不放任何触发 vitest/coverage 的命令——覆盖率建议由 prepare-commit-msg
# 只读 frontend/coverage/coverage-final.json，不在此触发（避免提交前跑慢检查）。
# gen 前快照：记录 docs/ 与 locales/ 下文件的 (mtime, size)，gen 后只 stage 本次
# gen 实际 touch 的文件——防止 10+ AI 并发共享 checkout 时把他人未提交的
# docs/locales 半成品扫进本次 commit（2026-08-17 门禁锐评 P2-2 修复）。
# 快照文件用 $$ 进程后缀 + trap 清理：并发 pre-commit 互不覆盖（code_review P2）；
# find -printf 仅 GNU 可用（Windows Git Bash OK），BSD 平台降级用 node 一行替代。
# gen 目标配置在 scripts/_lib/gen-config.ts（单一事实源），新增目标改此处即可。
GEN_SNAP="/tmp/ysm_gen_snap_before_$$.txt"
GEN_SNAP_AFTER="/tmp/ysm_gen_snap_after_$$.txt"
snap_docs() {
  # 跨平台优先 node（Windows Git Bash 下 find -printf 偶发不可靠，会令 GEN_SNAP 缺失
  # 进而跌入兜底 git add -u docs/ 吞他人半成品）；find 仅作 GNU 快路径
  if command -v node >/dev/null 2>&1; then
    node -e '
      const fs=require("fs"),path=require("path");
      const out=[];
      for (const base of ["docs","frontend/public/locales","completions"]) {
        if (!fs.existsSync(base)) continue;
        const walk=(d)=>{for(const e of fs.readdirSync(d)){const p=path.join(d,e),s=fs.statSync(p);if(s.isDirectory())walk(p);else out.push(`${s.mtimeMs} ${s.size} ${p}`);}};
        walk(base);
      }
      fs.writeFileSync(process.argv[1], out.sort().join("\n"));
    ' "$1" 2>/dev/null && [ -s "$1" ] && return 0
  fi
  # GNU 平台 find 快路径（失败静默，交由下方兜底分支处理）
  find docs/ frontend/public/locales/ completions/ -type f -printf '%T@ %s %p\n' 2>/dev/null | sort > "$1" || true
}
trap 'rm -f "$GEN_SNAP" "$GEN_SNAP_AFTER"' EXIT
snap_docs "$GEN_SNAP"
echo "[pre-commit] 文档自动同步..."
# ADR-151 项 6：gen 清单收敛到 scripts/_lib/gen-cmds.ts 单一事实源（TS 侧 import / sh 侧逐行消费），
# 取代内联 15 个清单——避免与 commit-with-check 内联清单漂移（原漂移 4 个命令）。
node scripts/_lib/gen-cmds.ts | while IFS= read -r line; do
  [ -z "$line" ] && continue
  # shellcheck disable=SC2086（有意分词以携带 --file 等参数）
  node scripts/$line >/dev/null 2>&1 || echo "⚠️  scripts/$line 执行失败（不阻断）"
done

# ── stage 生成的文档（只 stage 本次 gen 实际 touch 的文件，无 diff 则无副作用） ──
# 2026-08-17 P2-2 修复：不再无条件 `git add docs/`——并发共享 checkout 下会把他人
# 未提交 docs/locales 半成品扫进本次 commit。改为 gen 前后快照对比，只 add 变化文件。
# ADR-151 续（2026-09-01 卷带实证）：snap 快照 diff 用「mtime 变化」判定 gen 产物在并发
# 下失效——并行会话手改的卡恰在快照窗口内被 touch → 误判 gen 产物 → 被 --only 提交卷带
# （实证 fbx-cli-pipeline.md / frontend_test_audit.md 卷进 e96b47e3）。
# 修复：stage 判定下沉到 scripts/_lib/gen-stage.ts（单一事实源，契约测试守护）——
#   stage = 快照变化 ∩ 非并行 dirty（git status --porcelain 排除；?? 未跟踪按 gen 前后
#   存在性区分：gen 前存在=并行新建排除，不存在=gen 新建保留）。补全型 gen 产物正常入库。
ADD_FAIL=""
if [ -f "$GEN_SNAP" ]; then
  # 生成物 stage 清单：快照变化 − 并行 dirty（替代原 find/diff/awk 脆弱管道）
  node scripts/_lib/gen-stage.ts "$GEN_SNAP" > /tmp/ysm_gen_to_stage.txt 2>/dev/null
while IFS= read -r p; do
    [ -z "$p" ] && continue
    [ -f "$p" ] || continue
    git add -- "$p" 2>/dev/null || ADD_FAIL="$ADD_FAIL $p"
  done < /tmp/ysm_gen_to_stage.txt
  # 供 post-commit 消费：记录本次 stage 的生成物清单（固定路径 last-writer-wins；
  # 并发会话各自 pre-commit 覆盖，post-commit 消费最新一份即可）。code_review #2：
  # post-commit 只清本清单内文件，杜绝「wd==HEAD 判定」误清用户仅存索引的暂存。
  git rev-parse --git-dir >/dev/null 2>&1 && cp /tmp/ysm_gen_to_stage.txt "$(git rev-parse --git-dir)/ysm_gen_staged" 2>/dev/null || true
  rm -f "$GEN_SNAP" /tmp/ysm_gen_snap_after.txt
else
  # 快照缺失（find/node 均异常）→ 严禁兜底 git add -u docs/：会吞他人未提交 docs 半成品
  # （违反 2026-08-17 P2-2 并发隔离）。仅置标志，由下方统一告警，不自动 stage。
  GEN_SKIPPED=1
fi

if [ -n "$ADD_FAIL" ]; then
  echo "⚠️  git add 失败（$ADD_FAIL），文档产物未 stage（不阻断 commit，请检查索引状态）"
elif [ -n "${GEN_SKIPPED:-}" ]; then
  echo "⚠️  文档快照缺失，自动 stage 已跳过（不吞未提交 docs 漂移）；如需 sync 请手动 git add 本次 gen 产物"
else
  echo "[pre-commit] ✅ 文档已同步并 stage（仅本次 gen 产物）"
fi

# ── Take巧 #2：drift --affected 秒级接入（ADR-087）──
# 取本次 stage 的变更文件，调 check-knowledge-drift --affected
# 过滤生成物（index.md/project-map.md 等 gen 脚本自身输出），避免误报
# 审计修复（2026-08-17 子代理）：逐文件传递避免路径含空格断裂；不吞 stderr，失败可见。
echo ""
echo "[pre-commit] drift 检查受影响知识卡..."
CHANGED_FILES=$(git diff --cached --name-only 2>/dev/null || true)
if [ -n "$CHANGED_FILES" ]; then
  # 过滤生成物文件（pre-commit 自身产物，不应触发漂移告警）
  FILTERED=$(printf '%s\n' "$CHANGED_FILES" | grep -vE '^docs/(knowledge/index|project-map)\.md$' | grep -v '^frontend/public/locales/' || true)
  if [ -n "$FILTERED" ]; then
    # 批量 + --quiet：stem 列表供 prepare-commit-msg 消费；终端展示由 prepare-commit-msg 负责（避免双重输出）
    node scripts/check-knowledge-drift.ts --affected --quiet $FILTERED 2>&1 || echo "⚠️  drift 检查失败（不阻断）"
  fi
fi

# ── Take巧 #1：智能 stage（改源码 → 自动 stage 对应测试文件，ADR-087）──
# 当 git diff --cached 检测到新增/修改的 .ts/.js 源码文件时，
# 自动 stage 同目录/同名的 .test.ts / .test.js 测试文件。
# 防误 stage：仅当对应源码文件有改动时才 stage 测试文件。
# 审计修复（2026-08-17 子代理）：逐文件 git add "$f" 防空格断裂；排除 .test.*/.spec.* 防套娃。
echo ""
echo "[pre-commit] 智能 stage 测试文件..."
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.js' 2>/dev/null || true)
if [ -n "$STAGED_TS" ]; then
  printf '%s\n' "$STAGED_TS" | while IFS= read -r f; do
    [ -z "$f" ] && continue
    # 自身已是测试/规格文件，不套娃
    case "$f" in
      *.test.*|*.spec.*) continue ;;
    esac
    # 去掉后缀得到 base
    base="${f%.ts}"; base="${base%.js}"
    for ext in ".test.ts" ".test.js"; do
      candidate="${base}${ext}"
      if [ -f "$candidate" ]; then
        if git add -- "$candidate" 2>/dev/null; then
          echo "[pre-commit] 智能 stage: $candidate"
        else
          echo "⚠️  智能 stage 失败（不阻断）: $candidate"
        fi
      fi
    done
  done
fi

# ── Shadow DOM 样式越界检查（非阻断提示；阻断由 pre-push 门禁兜底）──
# 2026-08-24 复盘（21c01725 / 9942ada3）：components.css 全局 <link> 定义的类与 @keyframes
# 不穿透 Shadow DOM 边界，shadow 内引用静默失效。pre-commit 仅秒级提示，给 AI/人工即时反馈；
# 真正阻断在 pre-push（--strict）。逃生阀：YSM_SKIP_CSS_LAYER=1。
if [ "${YSM_SKIP_CSS_LAYER:-0}" != "1" ]; then
  echo ""
  echo "[pre-commit] Shadow 样式越界检查..."
  node scripts/css-layer-check.ts 2>&1 || echo "⚠️  css-layer-check 执行失败（不阻断）"
fi

# ── i18n 新增键三段式检查（非阻断提示；ADR-124）──
# CI 模式只查本次 diff 里的新增/修改 i18n 键是否符合三段式。违规走 stderr 提示，
# 不阻断 commit——误判/漏报由 tests/test_i18n_key_naming.ts 在 pre-push 守护
# （契约测试断言 validateKey 对 40 合规 + 3 违规用例的行为不回归）。
# 逃生阀：YSM_SKIP_I18N_KEY=1。
if [ "${YSM_SKIP_I18N_KEY:-0}" != "1" ]; then
  echo ""
  echo "[pre-commit] i18n 新增键三段式检查（ADR-124）..."
  node scripts/i18n-key-naming.ts 2>&1 || echo "⚠️  i18n-key-naming 发现违规或执行失败（不阻断，pre-push 测试兜底）"
fi

# ── gofmt 自动修复（staged go 文件；失败仅提示不阻断） ──
# 修复必须发生在提交时：pre-push 内 commit --amend 是假成功（push 推的是钩子前快照 oid，
# 钩子里 amend 只改本地 HEAD → 分叉，见 pre-push-gate.ts 已知坑 2026-08-12）。
# pre-commit 修复 + stage 后，pre-push 只读校验兜底（检出未格式化即阻断，防 --no-verify 绕过）。
if command -v gofmt >/dev/null 2>&1; then
  STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM -- '*.go' 2>/dev/null || true)
  if [ -n "$STAGED_GO" ]; then
    UNFMT=$(printf '%s\n' "$STAGED_GO" | xargs gofmt -l 2>/dev/null | grep -v '^$' || true)
    if [ -n "$UNFMT" ]; then
      echo "[pre-commit] gofmt 自动修复："
      printf '%s\n' "$UNFMT" | while IFS= read -r f; do
        [ -z "$f" ] && continue
        if git diff --quiet -- "$f"; then
          gofmt -w "$f" && git add "$f"  # 静默成功（gofmt 已原地改+stage）
        else
          echo "  ⚠️ $f 含未暂存编辑，跳过自动格式化（请手动 gofmt -w 后提交）"
        fi
      done
      echo "[pre-commit] ✅ go 文件处理完成"
    fi
  fi
else
  echo "⚠️  gofmt 不可用（PATH 异常），跳过 go 格式化。"
fi

# ── 版本防御：意外文件 / 跨层夹带提示（非阻断；88daf2a2 $tmp 教训）──
# 88daf2a2 把 8168 行覆盖率 profile 以字面量文件名 $tmp 入库，且夹带 R34 Go 修复。
# 这里只做秒级提示，阻断留给 pre-push（--strict）：
#   a) staged 文件名以 $ 开头 → shell 变量漏展开产物（如 $tmp）
#   b) staged 文件首行为 mode: set/count/atomic → Go 覆盖率 profile 误入库
#   c) 同 commit 同时含 frontend/ 与 go/ 改动 → 跨层夹带信号（合法联调可忽略）
# 逃生阀：YSM_SKIP_VERSION_DEFENSE=1
if [ "${YSM_SKIP_VERSION_DEFENSE:-0}" != "1" ]; then
  echo ""
  echo "[pre-commit] 版本防御检查（意外文件/跨层夹带）..."
  STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
  if [ -n "$STAGED_ALL" ]; then
    # a) $ 开头文件名
    SUSDOL=$(printf '%s\n' "$STAGED_ALL" | grep -E '(^|/)\$' || true)
    if [ -n "$SUSDOL" ]; then
      echo "  ⚠️  \$ 开头文件名（疑似 shell 变量漏展开产物，如 88daf2a2 的 \$tmp）："
      printf '    %s\n' "$SUSDOL"
    fi
    # b) Go 覆盖率 profile（首行 mode: set/count/atomic）
    BADCOV=$(printf '%s\n' "$STAGED_ALL" | while IFS= read -r f; do
      [ -f "$f" ] || continue
      head -1 "$f" 2>/dev/null | grep -qE '^mode: (set|count|atomic)$' && echo "$f"
    done)
    if [ -n "$BADCOV" ]; then
      echo "  ⚠️  疑似 Go 覆盖率 profile 入库："
      printf '    %s\n' "$BADCOV"
    fi
    # c) 跨层夹带（frontend/ + go/ 同时改动）
    F_CNT=$(printf '%s\n' "$STAGED_ALL" | grep -c '^frontend/' || true)
    G_CNT=$(printf '%s\n' "$STAGED_ALL" | grep -c '^go/' || true)
    if [ "$F_CNT" -gt 0 ] && [ "$G_CNT" -gt 0 ]; then
      echo "  ⚠️  本次 commit 同时含 frontend/(+$F_CNT) 与 go/(+$G_CNT) 改动——跨层夹带信号（合法联调可忽略）"
    fi
  fi
fi

# ── Take巧 #3：本次 commit 变更统计（commit 前预览，ADR-087）──
# 输出 staged 文件的 diff --stat（行数增删），比 status --short 更聚焦「本次 commit 内容」
# 锐评反馈（2026-08-17）：status 显示整个工作区（含未 stage 噪音），diff --cached 直接对应本次提交
echo ""
git diff --cached --stat 2>/dev/null | tail -10 || true

exit 0
