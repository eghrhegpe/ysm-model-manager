#!/bin/sh
# YSM 本地质量门禁（pre-push hook 薄壳）
# 职责：定位仓库根与 node → 透传 git 参数与 stdin → 调用 scripts/pre-push-gate.ts → 透传退出码。
# 安装：git config core.hooksPath .githooks
# 逃生阀（审计差异，2026-09-13 锐评 P1）：
#   YSM_SKIP_GATE=1 git push   —— 留痕逃生：钩子把待推 ref 写入 .git/gate-audit.log（SKIPPED 行）
#   git push --no-verify       —— 不留痕（钩子不执行是 git 语义边界，客户端无法检测）。
#    ⚠️ 现状澄清（2026-09-14 锐评核实）：CI **尚未**同跑 gate —— test.yml 只调用 7 个脚本，
#      gate-config 的 ALL_STATIC_TOOLS 27 项（19 hard，另 DOC_EXTRA 2 项）在远端覆盖为 0（见 pre_push_gate.md:74
#      「CI 同跑 gate 互证（待立项）」）。故目前唯一兜底只有本地 gate-audit.log 的
#      连续性事后回溯（doctor --audit-check），--no-verify 的违规一旦推送即无远端拦截。
#      在 CI 接上 gate 之前，本钩子的阻断力 = 全场唯一防线，勿轻易 --no-verify。
# 调试：  YSM_GATE_DEBUG=1 git push
set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || exit 1)

if [ "${YSM_SKIP_GATE:-0}" = "1" ]; then
  echo "[pre-push] YSM_SKIP_GATE=1, gate skipped (audit trail written)"
  # 留痕逃生（锐评 P1）：消费 stdin（pre-push 每行 <localRef> <localOid> <remoteRef> <remoteOid>），
  # 逐行落审计；写失败静默——逃生不该因日志权限问题被二次阻断
  while read -r lref loid rref roid; do
    [ -n "$loid" ] || continue
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) SKIPPED $(echo "$loid" | cut -c1-12) SKIP SKIP/SKIP $1" \
      >> "$ROOT/.git/gate-audit.log" 2>/dev/null
  done
  exit 0
fi

NODE=$(command -v node 2>/dev/null)
if [ -z "$NODE" ]; then
  echo "[pre-push] ERROR: node not found in PATH — cannot run quality gate" >&2
  echo "[pre-push] fix: install Node.js, then retry push" >&2
  exit 1
fi

if [ "${YSM_GATE_DEBUG:-0}" = "1" ]; then
  echo "[pre-push] remote=$1 url=$2" >&2
fi

exec "$NODE" "$ROOT/scripts/pre-push-gate.ts" "$@"
