#!/bin/sh
# YSM commit-time 非阻断建议（prepare-commit-msg 薄壳）
# 职责：在终端(stderr)即时输出两类非阻断建议，不写入 commit message body：
#   📚 知识卡漂移 —— 受本次 staged 变更影响的知识卡（check-knowledge-drift --affected）
#   🔬 覆盖率建议 —— 低于语句覆盖率阈值的源文件（test-coverage-report --suggest）
# 设计：永远 exit 0，绝不阻断提交；提示信息经 stderr 直达终端（AI 必看通道）
# 安装：git config core.hooksPath .githooks（仓库已配置）
# 逃生阀：YSM_SKIP_KNOWLEDGE_HINT=1 / YSM_SKIP_COVERAGE_HINT=1 git commit
exec 1>&2

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -z "${ROOT:-}" ] && exit 0

NODE=$(command -v node 2>/dev/null)
[ -z "${NODE:-}" ] && exit 0

# 辅助脚本内部用 process.execPath 自取 node，无需透传 NODE_BIN；各自独立逃生阀
# 位置参数用 ${n:-} 守卫：git 某些调用路径下 $2 可能未设置，避免 nounset 中止提交
if [ "${YSM_SKIP_KNOWLEDGE_HINT:-0}" != "1" ]; then
  "$NODE" "$ROOT/scripts/hooks/knowledge-affected-hint.ts" "${1:-}" "${2:-}" || true
fi
if [ "${YSM_SKIP_COVERAGE_HINT:-0}" != "1" ]; then
  "$NODE" "$ROOT/scripts/hooks/coverage-suggest-hint.ts" "${1:-}" "${2:-}" || true
fi
# Go 函数覆盖率建议（非阻断）：仅本次 staged 改动包跑 coverprofile，指出低覆盖函数。
# 逃生阀：YSM_SKIP_GO_COVERAGE_HINT=1 git commit
if [ "${YSM_SKIP_GO_COVERAGE_HINT:-0}" != "1" ]; then
  "$NODE" "$ROOT/scripts/hooks/go-coverage-hint.ts" "${1:-}" "${2:-}" || true
fi
exit 0
