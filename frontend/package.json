{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "gen:locales": "node ../scripts/generate-locale-json.mjs",
    "build": "npm run gen:locales && vite build",
    "build:dev": "npm run gen:locales && vite build",
    "build:web": "npm run gen:locales && vite build --config vite.web.config.ts",
    "preview": "vite preview",
    "test": "vitest run --maxWorkers 8",
    "test:full": "vitest run",
    "test:audit": "vitest run --maxWorkers 8 --isolate=false --sequence.shuffle",
    "test:coverage": "vitest run --coverage --maxWorkers 8",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:e2e:web": "playwright test --config playwright.web.config.ts",
    "codemod": "node ../scripts/codemod.mjs",
    "generate:bindings": "cd .. && wails3 generate bindings -clean=true -ts -i",
    "verify:port": "node ../scripts/port-align.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.11.1",
    "jscpd": "^5.0.14",
    "knip": "^6.31.0",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@moeru/three-mmd": "^0.1.1",
    "@moeru/three-mmd-physics-ammo": "^0.1.1",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@wailsio/runtime": "^3.0.0-alpha.97",
    "fflate": "~0.8.2",
    "three": "^0.185.1"
  },
  "knip": {
    "ignoreDependencies": [
      "ts-morph"
    ]
  }
}
