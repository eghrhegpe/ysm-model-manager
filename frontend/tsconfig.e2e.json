{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"]
  },
  // e2e-web（真实 WebGL 链路）与主 e2e 同属 Playwright 用例域，一并纳入 typecheck
  // （此前漏收 → CI 的 tsc -p tsconfig.e2e.json 对 e2e-web 全盲，esbuild 剥类型不检查）
  // harness（组件隔离渲染层）同理：不收编则 typecheck 对其全盲（锐评 P1-2，2026-10-24）
  "include": [
    "e2e/**/*.ts",
    "e2e-web/**/*.ts",
    "harness/**/*.ts",
    "playwright.config.ts",
    "playwright.coverage.config.ts",
    "playwright.web.config.ts"
  ]
}
