{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "_lib/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "node_modules"
  ]
}
